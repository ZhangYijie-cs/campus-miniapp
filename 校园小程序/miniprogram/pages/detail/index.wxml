<view wx:if="{{food}}" class="detail"><swiper indicator-dots autoplay circular indicator-color="#ffffff88" indicator-active-color="#FF6B35" class="gallery"><swiper-item wx:for="{{food.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill" class="gallery-image"/><view class="gallery-caption">{{food.category}} · {{index===0?'招牌美味':index===1?'今日推荐':'食光精选'}} / 0{{index+1}}</view></swiper-item></swiper><view class="page"><view class="panel shop"><view class="eyebrow">A LITTLE PLACE, A BIG TASTE</view><view class="shop-title">{{food.name}}</view><view class="row"><view class="score-line"><text wx:for="{{food.stars}}" wx:key="value" class="star {{item.filled?'lit':''}}">★</text><text class="score">{{food.score}}</text><text class="muted"> · {{food.reviewCount}} 条评价</text></view><text class="tag">{{food.category}}</text></view><view class="subtitle">{{food.slogan}}</view><view class="divider"/><view class="info-line">📍 <text>{{food.address}}</text></view><view class="info-line">🕒 <text>{{food.hours}}</text></view><view class="info-line">💰 <text>人均消费 <text class="price">¥{{food.price}}</text></text></view></view><view class="panel"><view class="section-title">招牌必点 <text class="muted">/ 每一口都是心头好</text></view><view wx:for="{{food.dishes}}" wx:key="*this" class="dish"><view class="dish-icon">{{food.emoji}}</view><view><view>{{item}}</view><text class="muted">{{index===0?'店长推荐 · 来店必尝':'人气好味 · 值得一试'}}</text></view><text class="dish-number">0{{index+1}}</text></view></view><view class="panel"><view class="row"><view class="section-title">食客说</view><text class="muted">{{food.reviewCount}} 条用心分享</text></view><view class="review" wx:for="{{food.reviews}}" wx:key="id"><view class="row"><view class="review-user"><view class="avatar">{{item.mine?'😋':'🍊'}}</view><view><view class="nickname">{{item.nickname}}<text wx:if="{{item.mine}}" class="mine">我</text></view><view class="muted">{{item.time}}</view></view></view><view><text wx:for="{{item.stars}}" wx:for-item="star" wx:key="value" class="star {{star.filled?'lit':''}}">★</text></view></view><view class="review-content">{{item.content}}</view></view></view><view class="footer-note">店铺信息为模拟数据 · 实拍图片仅作美食示意</view></view><view class="action-bar"><button class="secondary" bindtap="favorite">{{food.favorite?'♥ 已收藏':'♡ 收藏'}}</button><button class="primary" bindtap="writeReview">✎ 写评价</button></view></view><view wx:elif="{{loaded}}" class="empty"><text class="empty-art">🍽️</text><view class="empty-title">这家店铺暂时找不到</view><button class="primary" bindtap="goHome">返回首页</button></view>
