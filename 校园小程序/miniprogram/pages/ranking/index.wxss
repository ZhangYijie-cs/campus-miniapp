.rank-card{display:flex;align-items:center;gap:16rpx;background:white;border-radius:16rpx;margin-bottom:20rpx;padding:24rpx 18rpx;box-shadow:0 6rpx 24rpx #6A3D1808}.rank-card.top{background:linear-gradient(120deg,#FFFDF7,#FFF1DA);border:1rpx solid #F7DCB3}.rank{width:44rpx;text-align:center;font-size:34rpx;color:#B7A593;font-weight:700;flex-shrink:0}.rank-image{width:114rpx;height:126rpx;border-radius:12rpx;flex-shrink:0}.rank-info{flex:1;min-width:0}.rank-score{display:flex;flex-direction:column;font-size:34rpx;color:#D18A1D;font-weight:800;align-items:center}.rank-score text{color:#FFB800;font-size:24rpx}.rank-info .card-title{font-size:27rpx}
