.profile-heading{display:flex;gap:24rpx;align-items:center;margin-top:22rpx}.profile-heading .title{font-size:40rpx;margin:0}.profile-avatar{font-size:64rpx;background:#FFFAF2;width:112rpx;height:112rpx;line-height:112rpx;text-align:center;border-radius:50%;border:6rpx solid #FFFFFF80;flex-shrink:0}.stats{display:flex;padding:32rpx}.stats>view{width:50%;text-align:center}.stats>view+view{border-left:1rpx solid #F0E7DC}.stat-number{font-size:54rpx;font-weight:800;color:#FF6B35;margin-bottom:8rpx}.diary{margin-top:0;margin-bottom:22rpx}.diary-name{font-weight:700;font-size:30rpx}.diary-stars{margin:18rpx 0}.diary-time{margin-top:18rpx}.body-text{white-space:pre-wrap;overflow-wrap:anywhere}
