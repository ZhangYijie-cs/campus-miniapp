page{background:#FFF8EF;color:#34251D;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,text,input,textarea,button{box-sizing:border-box}button{margin:0;font-size:28rpx;line-height:1.5}button::after{border:none}button[disabled]{opacity:.5} .page{padding:0 28rpx 40rpx}.hero{margin:0 -28rpx;padding:36rpx 32rpx 42rpx;background:linear-gradient(125deg,#FFE3BD,#FFF0D7 65%,#FFD8BD);position:relative;overflow:hidden}.eyebrow{font-size:20rpx;font-weight:700;letter-spacing:5rpx;color:#B5653D}.title{font-size:48rpx;font-weight:800;line-height:1.4;margin-top:12rpx}.subtitle{font-size:24rpx;color:#947562;margin-top:12rpx;line-height:1.7}.accent{color:#FF6B35}.hero-emoji{position:absolute;right:26rpx;top:32rpx;font-size:100rpx;transform:rotate(-12deg);opacity:.9}.section-head{display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 20rpx}.section-title{font-size:34rpx;font-weight:700}.muted{font-size:23rpx;color:#A08F83}.panel{background:white;border-radius:16rpx;padding:28rpx;margin-top:24rpx;box-shadow:0 8rpx 28rpx rgba(105,61,29,.045)}.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.food-card{width:48.3%;background:#FFF;border-radius:16rpx;overflow:hidden;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(105,61,29,.06);position:relative}.food-image{width:100%;height:260rpx;display:block;background:#FFE3BD}.card-body{padding:20rpx 18rpx}.card-title{font-size:28rpx;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.tag{display:inline-block;background:#FFF0E5;color:#C67442;font-size:20rpx;padding:5rpx 12rpx;border-radius:8rpx;margin:12rpx 0}.score-line{display:flex;align-items:center;gap:8rpx;flex-wrap:wrap}.star{color:#E4DDD4;font-size:24rpx}.star.lit{color:#FFB800}.score{color:#AB6A12;font-size:24rpx;font-weight:700}.price{color:#E5533E;font-size:32rpx;font-weight:700}.price-row{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx}.heart{position:absolute;right:12rpx;top:12rpx;width:60rpx;height:60rpx;padding:0;border-radius:50%;background:rgba(255,255,255,.95);color:#AB9586;font-size:38rpx;line-height:60rpx}.heart.saved{color:#FF6B35}.primary{background:#FF6B35;color:white;border-radius:14rpx;padding:22rpx 32rpx;font-weight:700}.secondary{background:#FFF0E5;color:#D66532;border-radius:14rpx;padding:22rpx}.empty{text-align:center;padding:80rpx 30rpx}.empty-art{font-size:100rpx;display:block;margin-bottom:20rpx}.empty-title{font-size:32rpx;font-weight:700}.empty .primary{margin:30rpx auto 0;display:inline-block}.divider{height:1rpx;background:#F4EBE2;margin:24rpx 0}.footer-note{text-align:center;font-size:21rpx;color:#B5A395;margin:26rpx 0}.row{display:flex;align-items:center;justify-content:space-between}.pill{font-size:21rpx;background:#FFFFFFA8;padding:10rpx 18rpx;border-radius:30rpx;color:#A26136;display:inline-block;margin-top:24rpx}.body-text{font-size:27rpx;line-height:1.9;color:#756357}

/* 实拍封面保留更大的展示区域，暖色背景承接照片。 */
.food-image{background:#EFE3D6}.heart{box-shadow:0 4rpx 16rpx rgba(50,30,15,.12)}
