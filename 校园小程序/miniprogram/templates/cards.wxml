<template name="cards"><view class="grid"><view wx:for="{{foods}}" wx:key="id" class="food-card" data-id="{{item.id}}" bindtap="openFood"><image class="food-image" src="{{item.image}}" mode="aspectFill"/><button class="heart {{item.favorite ? 'saved' : ''}}" data-id="{{item.id}}" catchtap="favorite" aria-label="{{item.favorite ? '取消收藏' : '收藏店铺'}}">{{item.favorite ? '♥' : '♡'}}</button><view class="card-body"><view class="card-title">{{item.name}}</view><text class="tag">{{item.category}}</text><view class="score-line"><view><text wx:for="{{item.stars}}" wx:for-item="star" wx:key="value" class="star {{star.filled ? 'lit' : ''}}">★</text></view><text class="score">{{item.score}}</text></view><view class="price-row"><view><text class="price">¥{{item.price}}</text><text class="muted"> /人</text></view><text class="muted">{{item.reviewCount}}评</text></view></view></view></view></template>
