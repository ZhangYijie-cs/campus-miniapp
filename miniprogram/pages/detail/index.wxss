.detail{padding-bottom:160rpx}.gallery{height:460rpx}.gallery-image{width:100%;height:100%}.gallery-caption{position:absolute;bottom:28rpx;left:28rpx;background:#34251DBB;color:white;border-radius:30rpx;padding:10rpx 20rpx;font-size:22rpx}.shop{position:relative;margin-top:-12rpx}.shop-title{font-size:42rpx;font-weight:800;margin:16rpx 0}.info-line{display:flex;gap:18rpx;align-items:center;margin:22rpx 0;color:#7D6759;font-size:26rpx}.dish{display:flex;align-items:center;gap:22rpx;padding-top:28rpx}.dish-icon{background:#FFF2E0;border-radius:14rpx;width:86rpx;height:86rpx;line-height:86rpx;text-align:center;font-size:46rpx}.dish-number{margin-left:auto;font-size:34rpx;color:#E7CDB5;font-style:italic}.dish .muted{display:block;margin-top:8rpx}.review{padding-top:28rpx;margin-top:24rpx;border-top:1rpx solid #F4EBE2}.review-user{display:flex;gap:14rpx;align-items:center;min-width:0}.avatar{width:65rpx;height:65rpx;border-radius:50%;background:#FFF2DB;text-align:center;line-height:65rpx;font-size:34rpx;flex-shrink:0}.nickname{font-size:26rpx;margin-bottom:7rpx;overflow-wrap:anywhere}.mine{color:#FF6B35;font-size:20rpx;margin-left:8rpx}.review .star{font-size:20rpx}.review-content{line-height:1.9;font-size:27rpx;color:#756357;margin-top:18rpx;white-space:pre-wrap;overflow-wrap:anywhere}.action-bar{position:fixed;bottom:0;left:0;right:0;background:#FFFFFFF5;display:flex;gap:22rpx;padding:20rpx 28rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));box-shadow:0 -4rpx 30rpx #5C32130A}.action-bar .primary{flex:1}.action-bar .secondary{width:210rpx}
